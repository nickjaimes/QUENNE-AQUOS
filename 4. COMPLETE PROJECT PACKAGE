logger = logging.getLogger(__name__)

class QuenneAquos:
    """Main entry point for QUENNE-AQUOS platform."""
    
    def __init__(self, config_path: Optional[str] = None):
        """
        Initialize QUENNE-AQUOS platform.
        
        Args:
            config_path: Path to configuration file. If None, uses defaults.
        """
        self.config_path = config_path
        self.platform = None
        self.orchestrator = None
        self.initialized = False
        
    async def initialize(self, **kwargs) -> 'QuenneAquos':
        """
        Initialize the platform with given configuration.
        
        Args:
            **kwargs: Configuration overrides
            
        Returns:
            Self for chaining
        """
        if self.initialized:
            logger.warning("Platform already initialized")
            return self
            
        try:
            logger.info(f"Initializing QUENNE-AQUOS v{__version__}")
            
            # Create orchestrator
            self.orchestrator = OceanPlatformOrchestrator(
                config_path=self.config_path,
                **kwargs
            )
            
            # Initialize platform
            self.platform = await self.orchestrator.initialize_platform()
            
            self.initialized = True
            logger.info("QUENNE-AQUOS platform initialized successfully")
            
        except Exception as e:
            logger.error(f"Failed to initialize platform: {e}")
            raise
            
        return self
    
    async def execute_mission(self, mission_config: Dict[str, Any]) -> Dict[str, Any]:
        """
        Execute an ocean sovereignty mission.
        
        Args:
            mission_config: Mission configuration dictionary
            
        Returns:
            Mission results
        """
        if not self.initialized:
            raise RuntimeError("Platform not initialized. Call initialize() first.")
            
        try:
            logger.info(f"Executing mission: {mission_config.get('name', 'Unnamed')}")
            
            # Execute mission through platform
            results = await self.platform.execute_mission(mission_config)
            
            logger.info(f"Mission completed: {results.get('status', 'Unknown')}")
            return results
            
        except Exception as e:
            logger.error(f"Mission execution failed: {e}")
            raise
    
    async def get_ocean_health(self, region: Optional[str] = None) -> Dict[str, Any]:
        """
        Get ocean health assessment for region.
        
        Args:
            region: Region name. If None, uses configured region.
            
        Returns:
            Ocean health metrics
        """
        if not self.initialized:
            raise RuntimeError("Platform not initialized. Call initialize() first.")
            
        return await self.platform.get_ocean_health(region)
    
    async def shutdown(self):
        """Gracefully shutdown the platform."""
        if self.platform:
            await self.platform.shutdown()
            self.initialized = False
            logger.info("QUENNE-AQUOS platform shutdown complete")
    
    def __enter__(self):
        """Synchronous context manager entry."""
        raise NotImplementedError("Use async context manager instead")
    
    def __exit__(self, exc_type, exc_val, exc_tb):
        """Synchronous context manager exit."""
        pass
    
    async def __aenter__(self):
        """Async context manager entry."""
        await self.initialize()
        return self
    
    async def __aexit__(self, exc_type, exc_val, exc_tb):
        """Async context manager exit."""
        await self.shutdown()

