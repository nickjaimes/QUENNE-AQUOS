              help='Output file for results')
@click.option('--real-time', '-r', is_flag=True, 
              help='Enable real-time monitoring during mission')
def execute(mission_file: str, output: Optional[str], real_time: bool):
    """Execute an ocean sovereignty mission."""
    
    # Load mission configuration
    with open(mission_file, 'r') as f:
        mission_config = json.load(f)
    
    mission_name = mission_config.get('name', 'Unnamed Mission')
    
    console.print(f"\n🚀 Executing Mission: [bold]{mission_name}[/bold]")
    console.print("=" * 50)
    
    async def _execute():
        try:
            async with QuenneAquos() as platform:
                # Execute mission
                if real_time:
                    # Stream results in real-time
                    console.print("[cyan]Real-time monitoring enabled[/cyan]")
                    
                    async def monitor_callback(update):
                        console.print(f"\n📊 Update: {update.get('stage', 'Unknown')}")
                        if 'metrics' in update:
                            for key, value in update['metrics'].items():
                                console.print(f"   {key}: {value}")
                    
                    results = await platform.execute_mission(
                        mission_config, 
                        monitor_callback=monitor_callback
                    )
                else:
                    # Execute with progress bar
                    with Progress(
                        SpinnerColumn(),
                        TextColumn("[progress.description]{task.description}"),
                        console=console
                    ) as progress:
                        
                        tasks = {
                            'planning': progress.add_task("Mission planning..."),
                            'execution': progress.add_task("Mission execution..."),
                            'analysis': progress.add_task("Data analysis...")
                        }
                        
                        async def progress_callback(stage, progress_value):
                            if stage in tasks:
                                progress.update(tasks[stage], completed=progress_value)
                        
                        results = await platform.execute_mission(
                            mission_config,
                            progress_callback=progress_callback
                        )
                
                # Display results
                console.print("\n🎉 Mission Completed!")
                console.print("=" * 50)
                
                # Create results table
                table = Table(title="Mission Results")
                table.add_column("Metric", style="cyan")
                table.add_column("Value", style="green")
                
                for key, value in results.items():
                    if isinstance(value, (int, float, str, bool)):
