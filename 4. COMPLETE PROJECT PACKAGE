version: '3.8'

services:
  # Quantum simulation backend
  quantum-simulator:
    image: quenne-aquos/quantum:latest
    build:
      context: ../../docker/images/quantum
      dockerfile: Dockerfile
    ports:
      - "8080:8080"
    environment:
      - QISKIT_TOKEN=${QISKIT_TOKEN}
      - QUANTUM_BACKEND=ibmq_qasm_simulator
      - MAX_QUBITS=512
    volumes:
      - ../../data/quantum:/app/data
      - ../../config/quantum:/app/config
    networks:
      - ocean-intelligence
    healthcheck:
      test: ["CMD", "python", "-c", "import qiskit; print('Quantum ready')"]
      interval: 30s
      timeout: 10s
      retries: 3

  # Neuromorphic simulation backend
  neuromorphic-simulator:
    image: quenne-aquos/neuromorphic:latest
    build:
      context: ../../docker/images/neuromorphic
      dockerfile: Dockerfile
    ports:
      - "8081:8081"
    environment:
      - NEUROMORPHIC_BACKEND=loihi_simulator
      - MAX_NEURONS=5000000
      - LEARNING_ENABLED=true
    volumes:
      - ../../data/neuromorphic:/app/data
      - ../../config/neuromorphic:/app/config
    networks:
      - ocean-intelligence
    deploy:
      resources:
        reservations:
          devices:
            - driver: nvidia
              count: 1
              capabilities: [gpu]

  # Triad AI agents
  triad-agents:
    image: quenne-aquos/triad:latest
    build:
      context: ../../docker/images/triad_agents
      dockerfile: Dockerfile
    ports:
      - "8082:8082"
    environment:
      - AGENT_TYPE=poseidon,triton,nereus
      - REGION=development
      - SOVEREIGNTY_LEVEL=development
    volumes:
      - ../../src/quenne_aquos:/app/src
      - ../../config/environments:/app/config
    networks:
      - ocean-intelligence
    depends_on:
      quantum-simulator:
        condition: service_healthy
      neuromorphic-simulator:
        condition: service_started

  # Ocean database
  ocean-database:
    image: timescale/timescaledb:latest-pg15
    ports:
      - "5432:5432"
    environment:
      - POSTGRES_DB=ocean_intelligence
      - POSTGRES_USER=${DB_USER}
      - POSTGRES_PASSWORD=${DB_PASSWORD}
    volumes:
      - ocean-data:/var/lib/postgresql/data
      - ../../data/schemas:/docker-entrypoint-initdb.d
    networks:
      - ocean-intelligence
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U ${DB_USER}"]
      interval: 10s
      timeout: 5s
      retries: 5

  # Time-series database
  timeseries-db:
    image: influxdb:2.7
    ports:
      - "8086:8086"
    environment:
      - DOCKER_INFLUXDB_INIT_MODE=setup
      - DOCKER_INFLUXDB_INIT_USERNAME=${INFLUX_USER}
      - DOCKER_INFLUXDB_INIT_PASSWORD=${INFLUX_PASSWORD}
      - DOCKER_INFLUXDB_INIT_ORG=quenne-aquos
      - DOCKER_INFLUXDB_INIT_BUCKET=ocean_data
      - DOCKER_INFLUXDB_INIT_ADMIN_TOKEN=${INFLUX_TOKEN}
    volumes:
      - influx-data:/var/lib/influxdb2
    networks:
      - ocean-intelligence

  # Message broker
  message-broker:
    image: rabbitmq:3.12-management
    ports:
      - "5672:5672"
      - "15672:15672"
    environment:
      - RABBITMQ_DEFAULT_USER=${RABBITMQ_USER}
      - RABBITMQ_DEFAULT_PASS=${RABBITMQ_PASSWORD}
    volumes:
      - rabbitmq-data:/var/lib/rabbitmq
    networks:
      - ocean-intelligence

  # Redis cache
