        console=console
    ) as progress:
        
        task = progress.add_task("Initializing ocean sovereignty platform...", total=None)
        
        async def _init():
            try:
                platform = QuenneAquos(config_path=config)
                await platform.initialize(region=region)
                
                progress.update(task, description="✅ Platform initialized successfully")
