                    with open(output_path, 'w') as f:
                        json.dump(results, f, indent=2)
                    console.print(f"\n💾 Results saved to: {output_path}")
                
                return results
                
        except Exception as e:
            console.print(f"\n❌ Mission failed: {e}")
            raise
    
    asyncio.run(_execute())

