def main():
    """Main entry point."""
    parser = argparse.ArgumentParser(
        description="Deploy QUENNE-AQUOS to an ocean region"
    )
    parser.add_argument(
        'region_config',
        type=str,
        help='Path to region configuration YAML file'
    )
    parser.add_argument(
        '--dry-run',
        action='store_true',
        help='Perform dry run without actual deployment'
    )
    parser.add_argument(
        '--output',
        '-o',
        type=str,
        default='deployment_results.json',
        help='Output file for deployment results'
    )
    
    args = parser.parse_args()
    
    # Load region configuration
    config_path = Path(args.region_config)
    if not config_path.exists():
        print(f"❌ Region configuration file not found: {config_path}")
        return 1
    
    with open(config_path, 'r') as f:
        region_config = yaml.safe_load(f)
    
    # Create and run deployment
    deployment = RegionDeployment(region_config)
    
    async def run_deployment():
        return await deployment.deploy(dry_run=args.dry_run)
    
    results = asyncio.run(run_deployment())
    
    # Save results
    output_path = Path(args.output)
    with open(output_path, 'w') as f:
        json.dump(results, f, indent=2)
    
    # Print summary
    print("\n" + "="*60)
    print("📊 Deployment Summary")
    print("="*60)
    
    overall_status = results.get('overall_status', 'unknown')
    
    if overall_status == 'success':
        print("🎉 Deployment completed successfully!")
    elif overall_status == 'failed':
        print("❌ Deployment failed!")
    else:
        print(f"⚠️  Deployment status: {overall_status}")
    
    print(f"\n📝 Results saved to: {output_path}")
    
    # Print step results
    for step_name, step_result in results.items():
        if step_name != 'overall_status':
            success = step_result.get('success', False)
            status = "✅" if success else "❌"
            print(f"{status} {step_name}")
    
    return 0 if overall_status == 'success' else 1

if __name__ == '__main__':
    exit(main())
