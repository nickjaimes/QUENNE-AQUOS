        checks = self.check_prerequisites()
        
        failed_checks = [name for name, passed in checks.items() if not passed]
        
        # Critical checks (non-optional)
        critical_checks = ['python_version', 'docker', 'docker_compose', 'git', 'memory']
        critical_failed = [name for name in critical_checks if name in failed_checks]
        
        if critical_failed:
            print(f"\n❌ Critical prerequisites missing: {', '.join(critical_failed)}")
            print("Please install missing requirements and run setup again.")
            sys.exit(1)
        
        if failed_checks:
            print(f"\n⚠️  Some optional prerequisites missing: {', '.join(failed_checks)}")
