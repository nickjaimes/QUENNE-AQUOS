    console.print("\n🌊 QUENNE-AQUOS Basic Mission Example")
    console.print("=" * 60)
    
    # Mission configuration
    mission_config = {
        "name": "Pacific Ecosystem Assessment",
        "type": "ecosystem_health_monitoring",
        "description": "Basic ecosystem health assessment in Pacific region",
        "area": {
            "latitude_range": [0, 5],
            "longitude_range": [160, 165],
            "depth_range": [0, 500]
        },
        "duration": "2h",
        "objectives": [
            "assess_biodiversity",
            "monitor_water_quality",
            "detect_human_impact",
            "map_ocean_currents"
        ],
        "assets": {
            "auvs": 3,
            "usvs": 2,
            "sensors": ["acoustic", "optical", "chemical", "thermal"]
        },
        "reporting": {
            "interval": "30m",
            "format": "json",
            "visualization": True
        }
    }
    
    console.print(f"🚀 Mission: [bold]{mission_config['name']}[/bold]")
    console.print(f"📍 Area: {mission_config['area']['latitude_range'][0]}°N to "
                  f"{mission_config['area']['latitude_range'][1]}°N, "
                  f"{mission_config['area']['longitude_range'][0]}°E to "
                  f"{mission_config['area']['longitude_range'][1]}°E")
    console.print(f"🎯 Objectives: {', '.join(mission_config['objectives'])}")
    console.print(f"⏱️  Duration: {mission_config['duration']}")
    
    # Initialize platform
    with Progress(
        SpinnerColumn(),
        TextColumn("[progress.description]{task.description}"),
        console=console
    ) as progress:
        
        task = progress.add_task("Initializing QUENNE-AQUOS platform...", total=None)
        
        try:
            # Initialize platform
            platform = QuenneAquos()
            await platform.initialize(region='pacific')
            
            progress.update(task, description="✅ Platform initialized")
            
            # Execute mission
            progress.update(task, description="🚀 Executing mission...")
            
            results = await platform.execute_mission(mission_config)
            
            progress.update(task, description="✅ Mission completed")
            
        except Exception as e:
            progress.update(task, description=f"❌ Mission failed: {e}")
            raise
    
    # Display results
    console.print("\n📊 Mission Results Summary")
    console.print("=" * 60)
    
    # Create results table
    table = Table(title="Mission Metrics")
    table.add_column("Metric", style="cyan", no_wrap=True)
    table.add_column("Value", style="green")
    table.add_column("Status", style="magenta")
    
    # Extract key metrics
    metrics = {
        "Status": results.get('status', 'Unknown'),
        "Duration": results.get('duration', 'N/A'),
        "Area Covered": f"{results.get('area_covered_km2', 0):.1f} km²",
        "Data Collected": f"{results.get('data_volume_gb', 0):.1f} GB",
        "Species Detected": results.get('species_count', 0),
        "Threats Identified": results.get('threat_count', 0),
        "Water Quality Index": f"{results.get('water_quality_index', 0):.2f}/1.0",
        "Biodiversity Score": f"{results.get('biodiversity_score', 0):.2f}/1.0",
        "Carbon Sequestration": f"{results.get('carbon_flux', 0):.1f} tCO₂/day",
        "Energy Efficiency": f"{results.get('energy_efficiency', 0):.1%}",
    }
    
    for metric, value in metrics.items():
        # Determine status color
        if metric in ['Water Quality Index', 'Biodiversity Score']:
            numeric_value = float(value.split('/')[0])
            if numeric_value >= 0.8:
                status = "✅ Excellent"
            elif numeric_value >= 0.6:
                status = "⚠️ Good"
            elif numeric_value >= 0.4:
                status = "⚠️ Fair"
            else:
                status = "❌ Poor"
        elif metric == 'Threats Identified':
            status = "⚠️ Alert" if value > 0 else "✅ Clear"
        elif metric == 'Status':
            status = "✅ Success" if value == 'completed' else f"⚠️ {value}"
        else:
            status = "📊 Measured"
        
        table.add_row(metric, str(value), status)
    
    console.print(table)
    
    # Display threats if any
    threats = results.get('threats', [])
    if threats:
        console.print("\n🚨 Threats Detected")
        console.print("=" * 60)
        
        threat_table = Table()
        threat_table.add_column("Type", style="red")
        threat_table.add_column("Location", style="yellow")
        threat_table.add_column("Confidence", style="cyan")
        threat_table.add_column("Action", style="green")
        
        for threat in threats[:5]:  # Show top 5 threats
            threat_table.add_row(
                threat.get('type', 'Unknown'),
                f"{threat.get('latitude', 0):.4f}°, {threat.get('longitude', 0):.4f}°",
                f"{threat.get('confidence', 0):.1%}",
                threat.get('action_taken', 'Monitoring')
            )
        
        console.print(threat_table)
        
        if len(threats) > 5:
            console.print(f"  ... and {len(threats) - 5} more threats")
    
    # Display ecosystem health
    ecosystem = results.get('ecosystem_health', {})
    if ecosystem:
        console.print("\n🏥 Ecosystem Health Assessment")
        console.print("=" * 60)
        
        health_table = Table()
        health_table.add_column("Indicator", style="cyan")
        health_table.add_column("Score", style="green")
        health_table.add_column("Trend", style="magenta")
        
        for indicator, data in ecosystem.items():
            score = data.get('score', 0)
            trend = data.get('trend', 'stable')
            
            # Trend symbol
            if trend == 'improving':
                trend_symbol = "📈"
            elif trend == 'declining':
                trend_symbol = "📉"
            else:
                trend_symbol = "➡️"
            
            health_table.add_row(
                indicator.replace('_', ' ').title(),
                f"{score:.2f}/1.0",
                f"{trend_symbol} {trend}"
            )
        
        console.print(health_table)
    
    # Save results
    output_dir = Path("mission_results")
    output_dir.mkdir(exist_ok=True)
    
    timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
    output_file = output_dir / f"mission_{timestamp}.json"
    
    with open(output_file, 'w') as f:
        json.dump(results, f, indent=2)
    
    console.print(f"\n💾 Full results saved to: [bold]{output_file}[/bold]")
    
    # Cleanup
    await platform.shutdown()
    
    console.print("\n🎉 Mission Example Completed Successfully!")
    console.print("=" * 60)

def main():
    """Main entry point."""
    try:
        asyncio.run(run_basic_mission())
    except KeyboardInterrupt:
        console.print("\n\n⚠️ Mission interrupted by user")
