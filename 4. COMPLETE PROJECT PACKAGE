            }
    
    async def deploy_assets(self) -> Dict[str, Any]:
        """Deploy physical assets."""
        
        try:
            assets_config = self.region_config['assets']
            
            deployment_result = await self.deployer.deploy_physical_assets(
                surface_vessels=assets_config.get('surface', {}).get('count', 0),
